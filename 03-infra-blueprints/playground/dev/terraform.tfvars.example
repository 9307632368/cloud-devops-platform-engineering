aws_region  = "ap-south-1"
aws_profile = "default"
project_name = "infra-lab"
vpc_cidr = "10.42.0.0/16"
instance_type = "t3.micro"

# To allow only your own IP, replace this with something like "203.0.113.25/32".
# 0.0.0.0/0 makes the demo website reachable from anywhere.
allowed_http_cidr = "0.0.0.0/0"
